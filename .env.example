# Server
PORT=3000

# Auth
BEARER_TOKEN=replace-with-strong-random-token

# Limits
# MAX_PAYLOAD_BYTES=65536

# Certificate source
CERT_BASE_URL=http://pki.policia.es/cnp/MiDNI
CERT_FILE=APPDNIMOVIL.cer

# Certificate validation (none | basic | full)
CERT_VALIDATION=basic

# CA certificate (required for full validation)
# CA_CERT_PATH=/absolute/path/to/ca.pem
# CA_CERT_PEM="-----BEGIN CERTIFICATE-----..."

# Intermediate certificates (optional, PEM bundle)
# INTERMEDIATE_CERTS_PATH=/absolute/path/to/intermediates.pem
# INTERMEDIATE_CERTS_PEM="-----BEGIN CERTIFICATE-----..."

# OCSP
OCSP_URL=http://ocsp.policia.es

# Data output
# INCLUDE_THUMBNAIL_BASE64=false